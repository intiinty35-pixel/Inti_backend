PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Runtime: pooler en transaction mode (6543).
# sslmode=verify-full cifra Y verifica el certificado del servidor contra la CA
# raiz de Supabase, que vive versionada en certs/prod-ca-2021.crt. La ruta de
# sslrootcert se resuelve relativa al directorio del proyecto.
# Nunca uses sslmode=no-verify: desactiva la verificacion y permite MITM.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres?schema=public&sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt"
# Migraciones: pooler en session mode (5432). Obligatorio para prisma migrate
# (el transaction mode de 6543 no soporta advisory locks).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt"
CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@rpixghm0"
FIREBASE_PROJECT_ID=arizweb-5d378
# Produccion: usar una cuenta de servicio Firebase Admin.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@arizweb-5d378.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Genera ambos con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# El arranque falla si JWT_SECRET o ADMIN_PASSWORD siguen con un valor de ejemplo.
JWT_SECRET=REEMPLAZA_CON_64_BYTES_ALEATORIOS
AUTH_COOKIE_NAME=ariz_session
SESSION_TTL_HOURS=24
REMEMBER_TTL_DAYS=30

# Solo para el seed del administrador
ADMIN_EMAIL=admin@ariz.local
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CLAVE_FUERTE

# Brevo SMTP API. Nunca subas la clave real al repositorio.
BREVO_API_KEY=REEMPLAZA_CON_TU_API_KEY_DE_BREVO
BREVO_SENDER_EMAIL=arizcenter@gmail.com
BREVO_SENDER_NAME=ARIZ

