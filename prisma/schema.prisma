generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String?
  phone               String?
  biography           String?
  avatarUrl           String?
  role                Role                 @default(USER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leads               Lead[]
  professionalProfile ProfessionalProfile?
  favorites           Favorite[]
  priceAlerts         PriceAlert[]
  searchAlerts        SearchAlert[]
  adminProjects       AdminProject[]       @relation("AdminProjectCreator")
  referralChanges     ReferralStatusHistory[] @relation("ReferralStatusChanger")

  @@map("users")
}

model ProfessionalProfile {
  id            String             @id @default(uuid())
  userId        String             @unique
  type          ProfessionalType
  status        ApprovalStatus     @default(PENDING)
  dni           String?
  ruc           String?
  businessName  String?
  whatsapp      String?
  city          String
  districts     String?
  address       String?
  website       String?
  socialLinks   String?
  slug          String?            @unique
  /** Privilegio especial: sus proyectos publicados cuentan como "Proyectos Ariz" en el home, igual que los creados desde el panel de admin. */
  isOfficialDeveloper Boolean      @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  leads         Lead[]
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]
  projects      Project[]
  subscriptions PlanSubscription[]

  @@map("professional_profiles")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  price         Decimal  @db.Decimal(10, 2)
  currency      Currency @default(PEN)
  durationDays  Int
  propertyLimit Int
  projectLimit  Int      @default(0)
  features      String[] @default([])
  isFree        Boolean  @default(false)
  isDefault     Boolean  @default(false)
  isCustomerOnly Boolean @default(false)
  highlight     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions PlanSubscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  REJECTED
  EXPIRED
}

model PlanSubscription {
  id              String              @id @default(uuid())
  agentProfileId  String
  agentProfile    ProfessionalProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan                @relation(fields: [planId], references: [id])
  status          SubscriptionStatus  @default(PENDING_PAYMENT)
  receiptUrl      String?
  rejectionReason String?
  reviewedAt      DateTime?
  startedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([agentProfileId, status])
  @@index([status, createdAt])
  @@map("plan_subscriptions")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model PriceAlert {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  targetPrice Decimal? @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, isActive])
  @@map("price_alerts")
}

model SearchAlert {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("search_alerts")
}

model Property {
  id              String              @id @default(uuid())
  agentProfileId  String
  operationType   OperationType
  propertyType    PropertyType
  slug            String              @unique
  title           String
  description     String
  price           Decimal             @db.Decimal(14, 2)
  currency        Currency
  negotiable      Boolean             @default(false)
  maintenanceFee  Decimal?            @db.Decimal(12, 2)
  status          PropertyStatus      @default(DRAFT)
  featured        Boolean             @default(false)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactWhatsapp String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  publishedAt     DateTime?
  leads           Lead[]
  agentProfile    ProfessionalProfile @relation(fields: [agentProfileId], references: [id])
  amenities       PropertyAmenity[]
  details         PropertyDetails?
  location        PropertyLocation?
  media           PropertyMedia[]
  favorites       Favorite[]
  priceAlerts     PriceAlert[]

  @@index([status, featured, publishedAt])
  @@index([operationType, propertyType, status])
  @@map("properties")
}

model PropertyLocation {
  id                  String   @id @default(uuid())
  propertyId          String   @unique
  country             String   @default("PE")
  department          String
  province            String
  district            String
  address             String
  number              String?
  sector              String?
  reference           String?
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  approximateLocation Boolean  @default(true)
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([department, province, district])
  @@map("property_locations")
}

model PropertyDetails {
  id                 String              @id @default(uuid())
  propertyId         String              @unique
  totalArea          Decimal?            @db.Decimal(10, 2)
  constructedArea    Decimal?            @db.Decimal(10, 2)
  bedrooms           Int?
  bathrooms          Int?
  halfBathrooms      Int?
  parkingSpaces      Int?
  floor              Int?
  floors             Int?
  constructionYear   Int?
  conservationStatus ConservationStatus?
  specificDetails    Json?
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model Amenity {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String
  category   AmenityCategory
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model PropertyMedia {
  id         String    @id @default(uuid())
  propertyId String
  type       MediaType @default(IMAGE)
  url        String
  publicId   String?
  position   Int       @default(0)
  isCover    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_media")
}

model Project {
  id                String               @id @default(uuid())
  agentProfileId    String?
  category          ProjectCategory      @default(LOTIZACION)
  stage             ProjectStage
  slug              String               @unique
  name              String
  description       String
  currency          Currency
  priceFrom         Decimal              @db.Decimal(14, 2)
  priceTo           Decimal              @db.Decimal(14, 2)
  ruc               String?
  businessName      String?
  downPayment       Decimal?             @db.Decimal(14, 2)
  monthlyPayment    Decimal?             @db.Decimal(14, 2)
  financing         String[]             @default([])
  totalBlocks       Int?
  totalLots         Int?
  social            Json?
  services          String[]             @default([])
  urbanizationName  String?
  registryEntry     String?
  amenities         String[]             @default([])
  lotMode           LotMode
  constructionStart DateTime?
  estimatedDelivery DateTime
  certifications    String[]             @default([])
  status            ProjectStatus        @default(DRAFT)
  featured          Boolean              @default(false)
  tourUrl           String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  contactWhatsapp   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  publishedAt       DateTime?
  agentProfile      ProfessionalProfile? @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  adminProject      AdminProject?
  location          ProjectLocation?
  lots              ProjectLot[]
  milestones        ProjectMilestone[]
  media             ProjectMedia[]
  leads             Lead[]
  referrals         Referral[]

  @@index([status, featured, publishedAt])
  @@index([category, stage, status])
  @@map("projects")
}

model Referrer {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  email     String     @unique
  phone     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  referrals Referral[]

  @@map("referrers")
}

model Referral {
  id         String                   @id @default(uuid())
  referrerId String
  name       String
  email      String
  phone      String
  projectId  String
  status     ReferralStatus            @default(CONTACTED)
  code       String                   @unique
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  referrer   Referrer                 @relation(fields: [referrerId], references: [id], onDelete: Restrict)
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  history    ReferralStatusHistory[]

  @@index([referrerId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("referrals")
}

model ReferralStatusPoint {
  id        String         @id @default(uuid())
  status    ReferralStatus @unique
  points    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("referral_status_points")
}

model ReferralStatusHistory {
  id            String         @id @default(uuid())
  referralId    String
  fromStatus    ReferralStatus?
  toStatus      ReferralStatus
  pointsAwarded Int            @default(0)
  changedById   String?
  createdAt     DateTime       @default(now())
  referral      Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  changedBy     User?          @relation("ReferralStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([referralId, toStatus])
  @@index([referralId, createdAt])
  @@map("referral_status_history")
}

model AdminProject {
  id               String   @id @default(uuid())
  projectId        String   @unique
  createdByAdminId String
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByAdmin   User     @relation("AdminProjectCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([createdByAdminId, createdAt])
  @@map("admin_projects")
}

model ProjectLocation {
  id           String   @id @default(uuid())
  projectId    String   @unique
  country      String   @default("PE")
  department   String
  province     String
  district     String
  zone         String?
  street       String
  streetNumber String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([department, province, district])
  @@map("project_locations")
}

model ProjectLot {
  id           String    @id @default(uuid())
  projectId    String
  lotNumber    String
  block        String?
  areaM2       Decimal   @db.Decimal(10, 2)
  frontM       Decimal?  @db.Decimal(10, 2)
  price        Decimal   @db.Decimal(14, 2)
  status       LotStatus @default(AVAILABLE)
  planLocation String?
  lotCount     Int?
  position     Int       @default(0)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_lots")
}

model ProjectMilestone {
  id        String   @id @default(uuid())
  projectId String
  title     String
  date      DateTime
  note      String?
  position  Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

model ProjectMedia {
  id        String    @id @default(uuid())
  projectId String
  type      MediaType @default(IMAGE)
  url       String
  publicId  String?
  position  Int       @default(0)
  isCover   Boolean   @default(false)
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_media")
}

model InvestmentOpportunity {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  summary            String
  description        String   @db.Text
  areaLabel          String
  initialInvestment  Decimal  @db.Decimal(14, 2)
  currency           Currency @default(PEN)
  roiPercent         Decimal  @db.Decimal(5, 2)
  investmentGoal     String
  location           String
  department         String
  province           String
  district           String
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  coverImageUrl      String
  coverImagePublicId String?
  galleryImages      String[] @default([])
  highlights         String[] @default([])
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isPublished, updatedAt])
  @@map("investment_opportunities")
}

model Lead {
  id             String               @id @default(uuid())
  propertyId     String?
  projectId      String?
  agentProfileId String?
  userId         String?
  name           String
  email          String
  phone          String?
  message        String
  source         LeadSource
  createdAt      DateTime             @default(now())
  agentProfile   ProfessionalProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  property       Property?            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id])

  @@index([propertyId, createdAt])
  @@index([projectId, createdAt])
  @@index([agentProfileId, createdAt])
  @@map("leads")
}

enum Role {
  ADMIN
  USER
  REAL_ESTATE
}

enum ProfessionalType {
  INDEPENDENT_AGENT
  REAL_ESTATE_AGENCY
  DEVELOPER
  INDIVIDUAL_OWNER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OperationType {
  SALE
  RENT
  TEMPORARY_RENT
  TRANSFER
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  OFFICE
  COMMERCIAL
  WAREHOUSE
  ROOM
  PARKING
}

enum Currency {
  PEN
  USD
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  SOLD
  RENTED
  REJECTED
  ARCHIVED
}

enum ConservationStatus {
  NEW
  EXCELLENT
  GOOD
  REMODELED
  TO_REMODEL
  UNDER_CONSTRUCTION
}

enum AmenityCategory {
  INTERIOR
  SERVICES
  EXTERIOR
  BUILDING
}

enum MediaType {
  IMAGE
  VIDEO
  TOUR
  FLOOR_PLAN
  RENDER
}

enum LeadSource {
  PROPERTY_FORM
  PROJECT_FORM
  WHATSAPP
  QUICK_QUESTION
  PHONE
}

enum ReferralStatus {
  CONTACTED
  VISIT
  OPERATION_COMPLETED
}

enum ProjectCategory {
  LOTIZACION
}

enum ProjectStage {
  PRE_SALE
  UNDER_CONSTRUCTION
  DELIVERED
}

enum LotMode {
  INDIVIDUAL
  GROUP
}

enum LotStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  SOLD
  REJECTED
  ARCHIVED
}
